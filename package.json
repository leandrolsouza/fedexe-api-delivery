{
  "name": "fedexe-api",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write ui/src ui/index.html vite.config.ts tools/test-server.mjs tools/update-manifest.mjs",
    "format:check": "prettier --check ui/src ui/index.html vite.config.ts tools/test-server.mjs tools/update-manifest.mjs",
    "build:cli": "cargo build --locked --release --features cli --bin fedexe-runner && esbuild tools/fedexe.mjs --bundle --platform=node --target=node22 --format=esm --outfile=dist-cli/fedexe.mjs && node tools/build-cli.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@tauri-apps/api": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.25.12",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  }
}
